# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.fincoursa.com
NEXT_PUBLIC_DEFAULT_CURRENCY=AED

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never expose

# ---- Mux (Settings → Access tokens / Signing keys / Webhooks) ----
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=              # base64 private key from the signing key
NEXT_PUBLIC_INTRO_PLAYBACK_ID=        # optional: PUBLIC playback id for the homepage intro video

# ---- Payments: add one block per gateway ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_TEST_PAYMENTS=false             # true only on preview/staging: enables the "manual" test gateway

# ---- Affiliates / IBs ----
AFFILIATE_COOKIE_DAYS=30
# Partner codes credit a sale only when no referral link was used. Set to false to make links the only route.
PARTNER_CODES_ENABLED=true

# ---- Invoices (UAE VAT) ----
COMPANY_LEGAL_NAME=FinCoursa Academy
COMPANY_ADDRESS=
COMPANY_TRN=                          # VAT Tax Registration Number; when set, invoices are titled "Tax Invoice"

# ---- Cron (Vercel sets the Authorization header automatically) ----
CRON_SECRET=
